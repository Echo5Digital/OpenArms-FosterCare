# Copy this file to .env and fill in the values. .env is ignored by git and must never be committed.
# On Render, set the same variables in the service's Environment tab instead (Render also provides PORT itself).

# MongoDB Atlas connection string (Atlas > Database > Connect > Drivers) and the database to keep the leads in.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>
MONGODB_DB=openarms

# Owner login for the leads dashboard (/admin on the website). Make the hash with:
#   node backend/scripts/admin-password.mjs "your new password"        (run from the project root)
# More admins (email + password) are added later from the dashboard's Users page; they are kept in the database.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Signs the dashboard login; use a long random value (32+ characters), e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it logs everyone out of the dashboard.
AUTH_SECRET=

# The secret the website sends with every request, so only the website can use this server (24+ characters).
# Use the SAME value as BACKEND_API_KEY in the website's settings (Vercel / frontend/.env.local).
BACKEND_API_KEY=

# Email over SMTP: the welcome email a visitor gets after sending a form, and the notice the team gets about each form.
# Without SMTP_HOST, SMTP_USER and SMTP_PASS nothing is sent and the forms still work.
# For Gmail, SMTP_PASS must be an App Password (Google Account > Security > 2-Step Verification > App passwords),
# not the normal login password. Emails are sent from SMTP_USER, shown under the name SMTP_FROM_NAME.
# Render's free plan blocks SMTP ports, so on the live site the backend needs a paid plan for email to work.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# "false" for port 587 (STARTTLS), "true" for port 465
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Open Arms Foster Care
# Who is told about each new form (one address, or several separated by commas). Leave empty for no notices.
LEAD_NOTIFY_EMAIL=
# Optional: where a visitor's reply to the welcome email goes (default info@openarmsfostercare.com).
# EMAIL_REPLY_TO=info@openarmsfostercare.com

# Optional: forms one visitor may send per 10 minutes (default 10).
# LEADS_RATE_LIMIT=10

# Optional: port to listen on (default 4000; Render sets this itself).
# PORT=4000
