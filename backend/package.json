{
  "name": "openarms-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The Open Arms API server (Node + Hono): MongoDB, form submissions, admin login and the leads dashboard's data. Runs on Render; the website in ../frontend calls it.",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "build": "node build.mjs",
    "start": "node dist/server.js",
    "start:local": "node --env-file=.env dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "esbuild": "^0.28.2",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "mongodb": "^7.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
