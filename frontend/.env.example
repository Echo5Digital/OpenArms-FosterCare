# Copy this file to .env.local and fill in the values. .env.local is ignored by git and must never be committed.
# On the live site, set the same variables in the hosting provider's dashboard (Vercel > Settings > Environment Variables).
#
# The website no longer talks to the database itself: forms and the leads dashboard go through the backend server
# (the ../backend folder, deployed on Render). The database settings, the admin login and AUTH_SECRET all live there.

# Address of the backend server, no trailing slash. While working on your own computer it is the local backend:
BACKEND_URL=http://localhost:4000
# On the live site, the Render address, e.g.  BACKEND_URL=https://openarms-backend.onrender.com

# The secret shared with the backend: must be exactly the same as BACKEND_API_KEY in backend/.env (or on Render).
BACKEND_API_KEY=
