# Copy this file to .env.local and fill in the values. .env.local is ignored by git and must never be committed.
# On the live site, set the same variables in the hosting provider's dashboard instead.

# MongoDB Atlas connection string (Atlas > Database > Connect > Drivers) and the database to keep the leads in.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?appName=<app>
MONGODB_DB=openarms

# Owner login at /admin. Make the hash with:  node backend/scripts/admin-password.mjs "your new password"  (run from the project root)
# More admins (email + password) are added later from the dashboard's Users page; they are kept in the database.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# Signs the login cookie; use a long random value (32+ characters), e.g.  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it logs everyone out of the dashboard.
AUTH_SECRET=

# Optional: forms one visitor may send per 10 minutes (default 10).
# LEADS_RATE_LIMIT=10
